{
  "name": "a2-ordering",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "bash scripts/use-project-node.sh npm run dev --workspace @a2/admin",
    "build": "bash scripts/build-verified.sh",
    "start": "bash scripts/use-project-node.sh npm run start --workspace @a2/admin",
    "test": "npm run build && npm run test --workspace @a2/admin",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:webkit": "playwright test --project=storefront-webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "A2 Ordering"
}
